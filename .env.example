# Formspree configuration
# Replace with your actual Form ID from formspree.io
# Create a .env.local file and add this variable there
NEXT_PUBLIC_FORMSPREE_ID=YOUR_FORM_ID
NEXT_PUBLIC_CONTACT_EMAIL=vanzari@lightify.ro

# Baza de date Neon pentru calculele din calculatorul de pret.
# O pune Vercel automat cand conectezi Neon din tab-ul Storage; local o aduci cu
# `vercel env pull .env.local`. Daca lipseste, calculatorul merge dar nu salveaza nimic.
DATABASE_URL=
